// series-arc.dot — the crawl -> walk -> run arc of the ADK genmedia series.
// Theme: blog/graphic-theme.md §5. ADK=indigo box, MCP=teal box3d, Gemini=amber ellipse.
// Render:
//   dot -Tsvg blog/diagrams/series-arc.dot -o blog/diagrams/series-arc.svg
//   dot -Tpng -Gdpi=144 blog/diagrams/series-arc.dot -o blog/diagrams/series-arc.png
digraph series_arc {
  graph [fontname="Inter", bgcolor="#FBFBF8", rankdir=LR, splines=true,
         nodesep=0.4, ranksep=0.7, label="ADK Genmedia Series — crawl → walk → run\lADK weight rises monotonically; each step adds exactly one ADK construct.\l",
         labelloc="t", fontsize=15, fontcolor="#1F2933"];
  node  [fontname="Inter", fontsize=11, penwidth=1.6];
  edge  [fontname="JetBrains Mono", fontsize=9, color="#1F2933", penwidth=1.3];

  // ---- Tiers as ADK-construct nodes (indigo) ----
  node [shape=box, style="rounded,filled", fillcolor="#E8E6FD", color="#5B4FE9", fontcolor="#1F2933"];

  t0 [label="Tier 0 · Meet ADK\n(refreshed adk/ sample)\nLlmAgent + 4 MCPToolsets\nLLM drives across many tools"];

  subgraph cluster_crawl {
    label="CRAWL — single agent";
    fontname="Space Grotesk"; fontsize=13; fontcolor="#5B4FE9";
    color="#9AA5B1"; style="rounded"; bgcolor="#F1F3F4";
    p1 [label="1 · Photoshoot\nLlmAgent + 1 MCPToolset\n(tool_filter)"];
    p2 [label="2 · Director / Videographer\nLlmAgent + 1 MCPToolset\n(veo footguns)"];
    p3 [label="3 · Music Producer\nLlmAgent + 3 MCPToolsets\n(tool_name_prefix)"];
  }

  subgraph cluster_walk {
    label="WALK — first pipeline";
    fontname="Space Grotesk"; fontsize=13; fontcolor="#5B4FE9";
    color="#9AA5B1"; style="rounded"; bgcolor="#F1F3F4";
    w1 [label="4 · Scriptwriter / Storyboarder\nSequentialAgent + output_key\n(state handoff)"];
  }

  subgraph cluster_run {
    label="RUN — multi-agent app";
    fontname="Space Grotesk"; fontsize=13; fontcolor="#5B4FE9";
    color="#9AA5B1"; style="rounded"; bgcolor="#F1F3F4";
    r1 [label="5 · Ad creative-director's assistant\nSequentialAgent ⊃ ParallelAgent\n+ AgentTool (composes 1–3)"];
  }

  // MCP breadth annotations (teal) attached under the agents that peak on it
  node [shape=box3d, style="filled", fillcolor="#DBF3F1", color="#00A39C", fontsize=9];
  m_p1 [label="nanobanana"];
  m_p2 [label="veo"];
  m_p3 [label="lyria + TTS + avtool"];
  m_r1 [label="every server"];

  // Gemini-reasoning callouts (amber) at the ends to show it stays HIGH throughout
  node [shape=ellipse, style="filled", fillcolor="#FDF0CE", color="#F9A825", fontsize=9];
  g_start [label="Gemini art-directs\nfrom the very first agent"];
  g_end   [label="Gemini plans a\nduration-budgeted ad"];

  // ---- Arc flow ----
  edge [color="#1F2933"];
  t0 -> p1 -> p2 -> p3 -> w1 -> r1 [label="+1 construct"];

  // MCP breadth (teal dashed, no arrowhead)
  edge [style=dashed, color="#00A39C", arrowhead=none, fontcolor="#00A39C"];
  p1 -> m_p1; p2 -> m_p2; p3 -> m_p3; r1 -> m_r1;

  // Gemini stays high at both ends (amber dashed)
  edge [style=dashed, color="#F9A825", arrowhead=none, fontcolor="#F9A825"];
  p1 -> g_start; r1 -> g_end;

  // ---- Legend ----
  subgraph cluster_legend {
    label="Legend"; fontname="Inter"; fontsize=11; color="#9AA5B1"; style="rounded";
    L_adk    [shape=box,     style="rounded,filled", fillcolor="#E8E6FD", color="#5B4FE9", label="ADK construct"];
    L_mcp    [shape=box3d,   style="filled",         fillcolor="#DBF3F1", color="#00A39C", label="genmedia MCP"];
    L_gemini [shape=ellipse, style="filled",         fillcolor="#FDF0CE", color="#F9A825", label="Gemini reasoning"];
    L_adk -> L_mcp -> L_gemini [style=invis];
  }
}
