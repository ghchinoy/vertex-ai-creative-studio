// photoshoot.dot — architecture of the Photoshoot crawl agent (PR-1 / #1812).
// Theme: blog/graphic-theme.md §5.  Verified against merged photoshoot/photoshoot/agent.py.
// Render:
//   dot -Tsvg blog/diagrams/photoshoot.dot -o blog/diagrams/photoshoot.svg
//   dot -Tpng -Gdpi=144 blog/diagrams/photoshoot.dot -o blog/diagrams/photoshoot.png
digraph photoshoot {
  graph [fontname="Inter", bgcolor="#FBFBF8", rankdir=TB, splines=true,
         nodesep=0.35, ranksep=0.55,
         label="Photoshoot — one LlmAgent, one MCPToolset (nanobanana)\lThe value is Gemini's prompt craft + the verify step, not the single call.\l",
         labelloc="t", fontsize=14, fontcolor="#1F2933"];
  node  [fontname="Inter", fontsize=11, penwidth=1.6];
  edge  [fontname="JetBrains Mono", fontsize=9, color="#1F2933", penwidth=1.3];

  // user
  user [shape=oval, style=filled, fillcolor="#F1F3F4", color="#52606D",
        label="You\n\"a lone red umbrella on a\nrain-slicked Tokyo street\""];

  // Gemini reasoning
  gemini [shape=ellipse, style=filled, fillcolor="#FDF0CE", color="#F9A825", fontcolor="#1F2933",
          label="Gemini art-directs\nterse idea → rich prompt\n(composition · lens · light · mood)"];

  // ADK constructs
  agent [shape=box, style="rounded,filled", fillcolor="#E8E6FD", color="#5B4FE9",
         label="LlmAgent  name=\"photoshoot\"\nmodel=gemini-3.8-flash"];
  toolset [shape=box, style="rounded,filled", fillcolor="#E8E6FD", color="#5B4FE9",
           label="MCPToolset (stdio)\ntool_filter=[nanobanana_image_generation]"];

  // MCP server
  server [shape=box3d, style=filled, fillcolor="#DBF3F1", color="#00A39C",
          label="mcp-nanobanana-go\nnanobanana_image_generation"];

  // artifact + verify
  artifact [shape=folder, style=filled, fillcolor="#F1F3F4", color="#52606D",
            label="image artifact\n./output/*.png  (LOCAL)\nor gs://<bucket>/nanobanana_outputs/  (GCS)"];
  verify [shape=box, style="rounded,filled", fillcolor="white", color="#1E8E3E", fontcolor="#1E8E3E",
          label="Verify by existence\nreport the saved path / gs:// URI\n(gcloud storage ls for GCS)"];

  // gotcha
  gotcha [shape=box, style="rounded,filled,dashed", fillcolor="white", color="#E8590C", fontcolor="#E8590C",
          label="THE TRAP\nno output_directory AND no gcs_bucket_uri\nAND no GENMEDIA_BUCKET → bytes discarded\n(always pass one output mode)"];

  // flow
  user -> gemini [label="terse idea"];
  gemini -> agent [label="rich prompt"];
  agent -> toolset [label="tools=[…]"];
  toolset -> server [label="stdio call\nprompt, output mode"];
  server -> artifact [label="writes bytes"];
  artifact -> verify [color="#1E8E3E"];

  // gotcha contrast (orange dashed) off the toolset call
  toolset -> gotcha [style=dashed, color="#E8590C", arrowhead=none, label="if no dest"];

  // legend
  subgraph cluster_legend {
    label="Legend"; fontname="Inter"; fontsize=11; color="#9AA5B1"; style="rounded";
    L_adk    [shape=box,     style="rounded,filled", fillcolor="#E8E6FD", color="#5B4FE9", label="ADK"];
    L_mcp    [shape=box3d,   style="filled",         fillcolor="#DBF3F1", color="#00A39C", label="genmedia MCP"];
    L_gemini [shape=ellipse, style="filled",         fillcolor="#FDF0CE", color="#F9A825", label="Gemini"];
    L_ver    [shape=box,     style="rounded,filled", fillcolor="white",   color="#1E8E3E", fontcolor="#1E8E3E", label="verify"];
    L_got    [shape=box,     style="rounded,filled,dashed", fillcolor="white", color="#E8590C", fontcolor="#E8590C", label="gotcha"];
    L_adk -> L_mcp -> L_gemini -> L_ver -> L_got [style=invis];
  }
}
